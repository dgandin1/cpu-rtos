    __asm__("ADDI r14 r0 0");
    __asm__("ADDI r15 r0 128");
    __asm__("BEQ r14 r15 5");
    __asm__("SW r0 r14 101");
    __asm__("SW r0 r14 102");
    __asm__("ADDI r14 r14 2");
    __asm__("BEQ r0 r0 -4");

}

